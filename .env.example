# ==============================================================================
# GOING LIVE - CHECKLIST
# ------------------------------------------------------------------------------
# 1. APP_NAME is used inside messages as {{ company_name }} - set the real name.
# 2. APP_DEBUG must be false. When true, any error page dumps these settings,
#    including the SMS API key, to whoever triggered the error.
# 3. Run: php artisan key:generate   (never reuse the development APP_KEY)
# 4. Point the web server document root at the public/ folder, never the
#    project root, or this file becomes downloadable.
# 5. Create the admin login:  php artisan make:admin
#    Public /register is disabled by design.
# 6. Add the scheduler entry so greetings actually send:
#    * * * * * cd /path/to/birthday_manager && php artisan schedule:run >> /dev/null 2>&1
# 7. Run: php artisan migrate --force
# 8. Make storage/ and bootstrap/cache/ writable by the web server.
# 9. Set the real SMS sender ID and the real SMTP details, then send one test
#    of each from Gateway Config and SMTP Server.
# ==============================================================================

APP_NAME="Birthday Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Africa/Lagos

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=birthday_manager
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_ENABLED=true
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

BESTBULKSMS_API_KEY=
BESTBULKSMS_SENDER_ID=
BESTBULKSMS_SEND_URL=https://www.bestbulksms.com.ng/api/sms/send
BESTBULKSMS_BALANCE_URL=https://www.bestbulksms.com.ng/api/balance.php
BESTBULKSMS_STATUS_URL=https://www.bestbulksms.com.ng/api/message-status.php
BESTBULKSMS_ROUTE=standard
BESTBULKSMS_COUNTRY_CODE=234
